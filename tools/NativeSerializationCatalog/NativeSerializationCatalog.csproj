<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(UnrealEngineDirectory)/Binaries/DotNET/UnrealBuildTool/EpicGames.UHT.dll" />
    <Reference Include="$(UnrealEngineDirectory)/Binaries/DotNET/UnrealBuildTool/EpicGames.Core.dll" />
    <Reference Include="$(UnrealEngineDirectory)/Binaries/DotNET/UnrealBuildTool/Microsoft.Extensions.Logging.Abstractions.dll" />
  </ItemGroup>
  <Target Name="RequireEngine" BeforeTargets="ResolveReferences">
    <Error Condition="'$(UnrealEngineDirectory)' == ''" Text="Set UnrealEngineDirectory to the installed Engine directory." />
  </Target>
</Project>
